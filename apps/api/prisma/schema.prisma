generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  SALES
  MANAGEMENT
}

enum BusinessUnit {
  workshop
  machinery
}

enum LeadStatus {
  new
  contacted
  appointment
  quoted
  follow_up
  customer
  no_response
  lost
}

enum ProspectStatus {
  identified
  contacted
  interested
  follow_up
  closed
  lost
}

enum TaskStatus {
  pending
  in_progress
  completed
}

enum ContentStatus {
  idea
  script
  production
  editing
  approval
  scheduled
  published
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(EDITOR)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
  leads         Lead[]         @relation("LeadOwner")
  assignedTasks Task[]         @relation("TaskAssignee")
  createdTasks  Task[]         @relation("TaskCreator")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model Lead {
  id             String      @id @default(cuid())
  date           DateTime    @default(now())
  name           String
  phone          String
  businessUnit   BusinessUnit
  service        String
  channel        String
  city           String
  appointment    Boolean     @default(false)
  arrived        Boolean     @default(false)
  sold           Boolean     @default(false)
  amount         Decimal?    @db.Decimal(12, 2)
  product        String?
  need           String?
  company        String?
  purchaseWindow String?
  status         LeadStatus  @default(new)
  contactedAt    DateTime?
  slaBreached    Boolean     @default(false)
  ownerId        String?
  owner          User?       @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([businessUnit, date])
  @@index([status, createdAt])
  @@index([channel])
  @@map("leads")
}

model CompanyProspect {
  id         String         @id @default(cuid())
  company    String
  industry   String
  city       String
  contact    String
  phone      String
  need       String
  status     ProspectStatus @default(identified)
  nextAction String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([status, createdAt])
  @@map("company_prospects")
}

model Campaign {
  id           String       @id @default(cuid())
  key          String?      @unique
  name         String
  businessUnit BusinessUnit
  product      String
  audience     String
  objective    String
  budget       Decimal      @db.Decimal(12, 2)
  spent        Decimal      @default(0) @db.Decimal(12, 2)
  startsAt     DateTime
  endsAt       DateTime?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([businessUnit, active])
  @@map("campaigns")
}

model Product {
  id                 String       @id @default(cuid())
  sku                String       @unique
  name               String
  businessUnit       BusinessUnit
  category           String
  make               String?
  model              String?
  year               Int?
  quantity           Int          @default(1)
  hoursSinceOverhaul Int?
  summary            String
  price              Decimal?     @db.Decimal(14, 2)
  currency           String?
  channelRestriction String?
  active             Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([businessUnit, active])
  @@map("products")
}

model ServiceOffer {
  id           String       @id @default(cuid())
  sku          String       @unique
  name         String
  businessUnit BusinessUnit @default(workshop)
  description  String?
  vehicleType  String?
  price        Decimal?     @db.Decimal(12, 2)
  currency     String       @default("PEN")
  active       Boolean      @default(true)

  @@index([businessUnit, active])
  @@map("service_offers")
}

model ContentPiece {
  id           String        @id @default(cuid())
  key          String?       @unique
  title        String
  businessUnit BusinessUnit
  format       String
  channel      String
  pillar       String
  status       ContentStatus @default(idea)
  assignee     String?
  scheduledAt  DateTime?
  publishedAt  DateTime?
  campaignId   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([businessUnit, scheduledAt])
  @@index([status])
  @@map("content_pieces")
}

model Task {
  id           String     @id @default(cuid())
  key          String?    @unique
  title        String
  description  String?
  businessUnit BusinessUnit?
  status       TaskStatus @default(pending)
  priority     Int        @default(2)
  dueAt        DateTime?
  assigneeId   String?
  assignee     User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId    String?
  creator      User?      @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, dueAt])
  @@map("tasks")
}

model WeeklyReport {
  id          String   @id @default(cuid())
  weekStarting DateTime @unique
  metrics     Json
  createdAt   DateTime @default(now())

  @@map("weekly_reports")
}

model MediaAsset {
  id           String       @id @default(cuid())
  fileName     String
  storageKey   String       @unique
  contentType  String
  businessUnit BusinessUnit
  category     String
  uploadedBy   String?
  createdAt    DateTime     @default(now())

  @@index([businessUnit, category])
  @@map("media_assets")
}

model WorkspaceRecord {
  id         String   @default(cuid())
  collection String
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@id([collection, id])
  @@index([collection, updatedAt])
  @@map("workspace_records")
}